{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/schoolmanager-frontend/browser",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://pzhcpdznjoyukbhhodjz.supabase.co wss://pzhcpdznjoyukbhhodjz.supabase.co https://schoolmanager-xdxx.onrender.com https://api.schoolmanager.nocpbx.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/login/?$",
      "dest": "/login/index.html"
    },
    {
      "src": "^/auth/callback/?$",
      "dest": "/"
    },
    {
      "src": "^/dashboard/?$",
      "dest": "/"
    },
    {
      "src": "^/alumnos/?$",
      "dest": "/"
    },
    {
      "src": "^/matriculas/?$",
      "dest": "/"
    },
    {
      "src": "^/configuracion(?:/.*)?$",
      "dest": "/"
    },
    {
      "src": "^/responsables/?$",
      "dest": "/"
    },
    {
      "src": "^/cargos/?$",
      "dest": "/"
    },
    {
      "src": "^/pagos/?$",
      "dest": "/"
    },
    {
      "src": "^/portal-padre/?$",
      "dest": "/"
    },
    {
      "src": "^/home/?$",
      "dest": "/"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
