{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/schoolmanager-frontend/browser",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://pzhcpdznjoyukbhhodjz.supabase.co wss://pzhcpdznjoyukbhhodjz.supabase.co https://schoolmanager-xdxx.onrender.com https://api.schoolmanager.nocpbx.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "^/login/?$", "dest": "/index.html" },
    { "src": "^/dashboard/?$", "dest": "/index.html" },
    { "src": "^/alumnos/?$", "dest": "/index.html" },
    { "src": "^/matriculas/?$", "dest": "/index.html" },
    { "src": "^/configuracion(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/responsables/?$", "dest": "/index.html" },
    { "src": "^/cargos/?$", "dest": "/index.html" },
    { "src": "^/pagos/?$", "dest": "/index.html" },
    { "src": "^/portal-padre/?$", "dest": "/index.html" },
    { "src": "^/home/?$", "dest": "/index.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
